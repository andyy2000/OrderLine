# Copy to .env and fill in. Never commit .env.

# Claude (text agent, evals, voice bot)
ANTHROPIC_API_KEY=
ORDERLINE_MODEL=claude-haiku-5-5

# Voice bot
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Text the caller a confirmation after each order (1 = on). Needs the Twilio number below.
SEND_SMS_CONFIRMATIONS=0
TWILIO_SMS_FROM=+1XXXXXXXXXX

# Testing after closing time: 1 = the AI takes orders even when the hours say closed
ORDERLINE_ALWAYS_OPEN=0
# Seconds the AI waits for the kitchen to answer an ask_restaurant question
ASK_KITCHEN_TIMEOUT=30
# Trolls and dead air: seconds of silence before "Still there?" (then hang up), and the hard cap per call
CALLER_IDLE_SECONDS=12
MAX_CALL_SECONDS=480

# Kitchen server
ORDERLINE_DB=data/orderline.db
ADMIN_TOKEN=change-me
BOT_WS_URL=wss://your-bot-host/ws
PUBLIC_BASE_URL=https://your-kitchen-host
DEFAULT_RESTAURANT=tops-china
